
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#07090d">
<title>Something Big Is Coming</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

:root{
 --green:#20e879;
 --bg:#07090d;
 --muted:#aab5bf;
}

body{
 background:var(--bg);
 color:white;
 font-family:Arial,Helvetica,sans-serif;
 min-height:100vh;
 overflow-x:hidden;
}

.background{
 position:fixed;
 inset:0;
 z-index:-3;
 background:
 radial-gradient(ellipse at 50% 80%,#173b2c 0%,transparent 50%),
 radial-gradient(ellipse at 15% 15%,#252b3e 0%,transparent 45%),
 linear-gradient(140deg,#080b10,#101820,#050609);
}

.background:after{
 content:"";
 position:absolute;
 inset:-50%;
 background:repeating-linear-gradient(
  115deg,
  transparent 0 100px,
  #ffffff06 101px 102px
 );
 animation:move 35s linear infinite;
}

@keyframes move{
 to{transform:translate(120px,100px)}
}

.glow{
 position:fixed;
 width:400px;
 height:400px;
 background:#16e87818;
 filter:blur(100px);
 border-radius:50%;
 top:30%;
 left:35%;
 z-index:-2;
 animation:pulse 5s infinite alternate;
 pointer-events:none;
}

@keyframes pulse{
 to{transform:scale(1.5);opacity:.4}
}

header{
 width:min(1150px,90%);
 margin:auto;
 padding:28px 0;
 display:flex;
 justify-content:space-between;
 align-items:center;
}

.logo{
 font-size:27px;
 font-weight:1000;
 letter-spacing:-1.5px;
 color:var(--green);
}

.status{
 color:var(--green);
 font-size:10px;
 letter-spacing:3px;
 border:1px solid #20e87955;
 padding:10px 15px;
 border-radius:30px;
}

main{
 min-height:calc(100vh - 100px);
 display:flex;
 flex-direction:column;
 align-items:center;
 justify-content:center;
 text-align:center;
 padding:35px 20px 65px;
}

.eyebrow{
 color:var(--green);
 font-size:11px;
 font-weight:bold;
 letter-spacing:5px;
 margin-bottom:22px;
}

h1{
 font-size:clamp(45px,9vw,100px);
 font-weight:1000;
 line-height:.92;
 letter-spacing:-5px;
 text-shadow:0 10px 50px #000;
}

h1 span{color:var(--green)}

.subtitle{
 color:var(--muted);
 font-size:14px;
 line-height:1.9;
 max-width:520px;
 margin:24px auto 32px;
}

.countdown{
 display:flex;
 justify-content:center;
 flex-wrap:wrap;
 gap:12px;
 margin:10px 0 38px;
}

.timebox{
 width:105px;
 padding:19px 8px;
 background:#ffffff09;
 border:1px solid #ffffff1b;
 border-radius:9px;
 backdrop-filter:blur(15px);
 box-shadow:0 15px 40px #0004;
}

.number{
 display:block;
 color:var(--green);
 font-size:37px;
 font-weight:900;
 font-variant-numeric:tabular-nums;
}

.label{
 color:#9ba8b5;
 font-size:9px;
 letter-spacing:2px;
 margin-top:8px;
}

.teaser{
 width:min(440px,90vw);
 height:190px;
 margin:0 auto 25px;
 border:1px solid #20e87966;
 border-radius:12px;
 overflow:hidden;
 position:relative;
 background:
 radial-gradient(
  ellipse at center,
  #25513c 0%,
  #111c1a 45%,
  #080b10 100%
 );
 box-shadow:0 0 50px #20e87917;
 display:grid;
 place-items:center;
}

.teaser:before{
 content:"";
 position:absolute;
 inset:0;
 background:repeating-linear-gradient(
  0deg,
  transparent 0 4px,
  #0003 5px
 );
 pointer-events:none;
}

.teaser-glow{
 position:absolute;
 width:150px;
 height:150px;
 background:#20e87930;
 filter:blur(65px);
 border-radius:50%;
 animation:pulse 3s infinite alternate;
}

.coming-soon-content{
 position:relative;
 z-index:2;
 text-align:center;
}

.crown{
 font-size:48px;
 margin-bottom:10px;
 filter:drop-shadow(0 0 20px #20e87988);
 animation:teaserPulse 3s infinite alternate;
}

@keyframes teaserPulse{
 to{
  transform:scale(1.15);
  opacity:.65;
 }
}

.coming-title{
 color:var(--green);
 font-size:15px;
 font-weight:900;
 letter-spacing:4px;
}

.coming-subtitle{
 color:#aab5bf;
 font-size:8px;
 letter-spacing:2px;
 margin-top:9px;
}

.coming-line{
 width:65px;
 height:2px;
 background:var(--green);
 margin:13px auto 0;
 box-shadow:0 0 15px var(--green);
}

.teaser-caption{
 position:absolute;
 bottom:12px;
 left:15px;
 font-size:9px;
 color:var(--green);
 letter-spacing:3px;
 font-weight:bold;
 z-index:3;
}

.bottom-text{
 color:var(--green);
 font-size:10px;
 font-weight:bold;
 letter-spacing:3px;
 margin-top:10px;
}

footer{
 text-align:center;
 padding:20px;
 color:#67727d;
 font-size:10px;
 letter-spacing:2px;
 border-top:1px solid #ffffff12;
}

@media(max-width:500px){
 .timebox{
  width:calc(50% - 8px);
  max-width:145px;
 }

 h1{letter-spacing:-3px}

 .teaser{height:160px}

 header{padding:22px 0}

 .logo{font-size:22px}

 .status{
  font-size:8px;
  padding:9px;
 }

 .eyebrow{
  font-size:9px;
  letter-spacing:3px;
 }
}
</style>
</head>

<body>

<div class="background"></div>
<div class="glow"></div>

<header>
 <div class="logo">COMING SOON</div>
 <div class="status">● UNDER DEVELOPMENT</div>
</header>

<main>

 <div class="eyebrow">
  THE NEXT ERA STARTS SOON
 </div>

 <h1>
  SOMETHING<br>
  <span>BIG IS COMING.</span>
 </h1>

 <p class="subtitle">
  A new experience is taking shape.
  A new destination is being built.
  Get ready to discover what's coming next.
 </p>

 <div class="countdown">

  <div class="timebox">
   <span class="number" id="days">35</span>
   <div class="label">DAYS</div>
  </div>

  <div class="timebox">
   <span class="number" id="hours">08</span>
   <div class="label">HOURS</div>
  </div>

  <div class="timebox">
   <span class="number" id="minutes">15</span>
   <div class="label">MINUTES</div>
  </div>

  <div class="timebox">
   <span class="number" id="seconds">47</span>
   <div class="label">SECONDS</div>
  </div>

 </div>

 <div class="teaser">

  <div class="teaser-glow"></div>

  <div class="coming-soon-content">

   <div class="crown">👑</div>

   <div class="coming-title">
    VIDEO COMING SOON
   </div>

   <div class="coming-subtitle">
    SOMETHING SPECIAL IS IN THE WORKS
   </div>

   <div class="coming-line"></div>

  </div>

  <div class="teaser-caption">
   EXCLUSIVE FIRST LOOK
  </div>

 </div>

 <div class="bottom-text">
  THE COUNTDOWN HAS BEGUN.
 </div>

</main>

<footer>
 © 2026 · MADE BY TAY · THE NEXT ERA STARTS SOON
</footer>

<script>
const countdownDuration =
 35 * 24 * 60 * 60 * 1000 +
 8 * 60 * 60 * 1000 +
 15 * 60 * 1000 +
 47 * 1000;

let targetTime;

try{
 const savedTarget =
  localStorage.getItem("launchTime");

 if(savedTarget && Number(savedTarget)>Date.now()){
  targetTime=Number(savedTarget);
 }else{
  targetTime=Date.now()+countdownDuration;
  localStorage.setItem(
   "launchTime",
   String(targetTime)
  );
 }
}catch(error){
 targetTime=Date.now()+countdownDuration;
}

function updateCountdown(){
 const remaining=Math.max(
  0,
  targetTime-Date.now()
 );

 const days=Math.floor(remaining/86400000);
 const hours=Math.floor((remaining%86400000)/3600000);
 const minutes=Math.floor((remaining%3600000)/60000);
 const seconds=Math.floor((remaining%60000)/1000);

 document.getElementById("days").textContent=
  String(days).padStart(2,"0");

 document.getElementById("hours").textContent=
  String(hours).padStart(2,"0");

 document.getElementById("minutes").textContent=
  String(minutes).padStart(2,"0");

 document.getElementById("seconds").textContent=
  String(seconds).padStart(2,"0");

 if(remaining<=0){
  document.querySelector(".bottom-text").textContent=
   "THE WAIT IS OVER.";
 }
}

updateCountdown();
setInterval(updateCountdown,1000);
</script>

</body>
</html>
